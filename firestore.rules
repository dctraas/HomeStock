rules_version = '2';

// Publish these rules in the Firebase console under Firestore Database → Rules
// (or via `firebase deploy --only firestore:rules` if you use the Firebase CLI).
//
// Access model: anyone who is signed in (including anonymously — HomeStock signs
// every device in anonymously, there is no password login) AND knows a household's
// code can read and write everything under that household. The household code is
// the only access control — this is deliberately simple for a small household/family
// app and is not meant to protect sensitive data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{householdId} {
      // Anyone signed in can look up a household by its code ("get") or create a
      // new one. Listing the collection ("list") is explicitly denied — without
      // this split, any signed-in client could enumerate every household code
      // in the database in one unfiltered query, making the code meaningless as
      // an access control. The app itself never lists this collection, only
      // ever .document(code).get(), so this doesn't affect normal usage.
      //
      // "delete" is allowed so a member can permanently erase a household's data
      // (Instellingen > Huishouden > Huishouden verwijderen — the AVG/GDPR right to
      // erasure). "update" is allowed too — used to rename the household (Instellingen >
      // Huishouden > naam wijzigen) and to refresh its invite link's expiry (the
      // inviteExpiresAt field — see HouseholdRepository.refreshInviteExpiry).
      allow get, create, update, delete: if request.auth != null;
      allow list: if false;

      // All data for a household (products, inventory, shopping list, activity
      // log, scan history) lives in subcollections here.
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // In-app feedback (Instellingen > Algemeen > Over > Feedback). Write-only from
    // the client — there's nothing in the app that reads it back, so read/list/update/
    // delete are all denied to keep other users' feedback private.
    match /appFeedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, list, update, delete: if false;
    }

    // Shared, cross-household caches (see ProductRepository.kt) — Open Food Facts' own data
    // for a barcode, and its free-text search results, are identical for every household, so
    // these sit at the top level instead of duplicated under each households/{id} the way
    // personalized data does. Same trust model as the rest of this app (anyone signed in can
    // read/write): the worst a malicious client can do is write garbage into one cache entry
    // for one barcode/query, not access anything private. "list" stays denied for the same
    // reason as households/{householdId} above — the app only ever reads a single doc by id.
    match /products/{barcode} {
      allow get, create, update: if request.auth != null;
      allow list, delete: if false;
    }
    match /productSearchCache/{cacheId} {
      allow get, create, update: if request.auth != null;
      allow list, delete: if false;
    }

    // Shared caches written only by the Cloud Functions in functions/src/index.ts (via the
    // Admin SDK, which bypasses these rules entirely) — searchRecipes/getRecipeInformation/
    // translateRecipe. Denied to the client on every operation: unlike products/
    // productSearchCache above, there's no legitimate reason for the app itself to touch these
    // directly, so this is a hard deny rather than the same "anyone signed in" model.
    match /recipeSearchCache/{cacheId} {
      allow read, write: if false;
    }
    match /recipeDetailCache/{recipeId} {
      allow read, write: if false;
    }
    match /recipeTranslations/{docId} {
      allow read, write: if false;
    }
  }
}
