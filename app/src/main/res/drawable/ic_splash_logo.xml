<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp" android:height="288dp"
    android:viewportWidth="100" android:viewportHeight="100">
    <!-- This is the actual site of the "piece missing at the top" clipping that earlier rounds
         mistakenly kept trying to fix on the launcher icon instead. windowSplashScreenAnimatedIcon
         (see themes.xml) has no windowSplashScreenIconBackgroundColor set, so Android's
         SplashScreen API treats this as an icon-without-background: it must fit inside a 192dp
         circle within its 288dp canvas — a stricter, smaller safe zone (radius ratio ~0.333 of
         the canvas) than an adaptive launcher icon gets. At the old translateY-only centering
         (no scale-down at all), the mark's own farthest points sit ~40.6 units from its center
         in this 100-unit viewport — well outside a ~33.3-unit safe radius, so the handle's top
         got clipped exactly as reported. scale=0.5 brings that down to ~20.3, a real margin
         instead of none. translateX=25 ((50-50*0.5)) and translateY=24.88 ((50-50.25*0.5)) keep
         the (still precisely centered) mark on the canvas center (50,50) at the new scale. -->
    <group android:scaleX="0.5" android:scaleY="0.5"
        android:translateX="25" android:translateY="24.88">
        <path android:fillColor="@color/ic_launcher_mark"
            android:pathData="M24,36 H76 L71,82 A6,6 0 0 1 65,88 H35 A6,6 0 0 1 29,82 Z" />
        <path android:strokeColor="@color/ic_launcher_mark" android:strokeWidth="7"
            android:strokeLineCap="round" android:fillColor="@android:color/transparent"
            android:pathData="M37,36 V29 A13,13 0 0 1 63,29 V36" />
        <path android:strokeColor="@color/ic_launcher_check" android:strokeWidth="9"
            android:strokeLineCap="round" android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M38,60 L47,69 L64,50" />
    </group>
</vector>
