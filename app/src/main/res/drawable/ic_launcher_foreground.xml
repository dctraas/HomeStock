<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- translateX/Y recenter the mark within the 108dp canvas — the naive "shrink 0.8, inset
         10.8 on every side" formula this originally shipped with only holds if the raw path
         data already fills the viewport edge to edge, which it doesn't. Its true bounding box
         is x:[24,76] (centered at 50 already) and y:[12.5,88] (centered at 50.25, not 58.5) —
         the handle (M37,36 V29 A13,13...) is a semicircle centered at (50,29) with radius 13,
         so it peaks at y=16, and its 7dp stroke extends that another 3.5 upward to y=12.5; an
         earlier pass here only accounted for the handle's start point (y=29), undercorrecting
         and leaving the mark sitting visibly high. translateX=14 ((54-50*0.8)) and
         translateY=13.8 ((54-50.25*0.8)) put the true center at the canvas center (54,54) —
         no extra shrinking beyond the original 0.8 scale needed; a since-clipping issue on the
         home screen turned out to actually be the splash screen (see ic_splash_logo.xml), not
         this file, which renders fine at this size. -->
    <group android:scaleX="0.8" android:scaleY="0.8"
        android:translateX="14" android:translateY="13.8">
        <path android:fillColor="@color/ic_launcher_mark"
            android:pathData="M24,36 H76 L71,82 A6,6 0 0 1 65,88 H35 A6,6 0 0 1 29,82 Z" />
        <path android:strokeColor="@color/ic_launcher_mark" android:strokeWidth="7"
            android:strokeLineCap="round" android:fillColor="@android:color/transparent"
            android:pathData="M37,36 V29 A13,13 0 0 1 63,29 V36" />
        <path android:strokeColor="@color/ic_launcher_check" android:strokeWidth="9"
            android:strokeLineCap="round" android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M38,60 L47,69 L64,50" />
    </group>
</vector>
