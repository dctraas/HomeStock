<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- Recenters AND shrinks the mark into the adaptive-icon safe zone (a 66dp circle centered
         on the canvas, radius 33 from (54,54) — content outside it can get clipped, and does on
         at least one real launcher, by a previous pass here that only left ~2.8dp of margin at
         the tightest point). That tightest point isn't the handle's peak (y=16, the thing this
         comment used to center on) — it's the bag body's own bottom corners, near (35,88)/
         (65,88), which sit further from the mark's true center (50, 50.25) than the handle peak
         does (~40.6dp vs ~37.75dp). scale=0.65 (down from 0.8) brings that corner in to ~26.4dp
         from center, a real ~6.6dp safety margin instead of shaving it down to the edge.
         translateX=21.5 ((54-50*0.65)) and translateY=21.34 ((54-50.25*0.65)) put the (still
         precisely centered) mark's center back on the canvas center (54,54) at the new scale. -->
    <group android:scaleX="0.65" android:scaleY="0.65"
        android:translateX="21.5" android:translateY="21.34">
        <path android:fillColor="@color/ic_launcher_mark"
            android:pathData="M24,36 H76 L71,82 A6,6 0 0 1 65,88 H35 A6,6 0 0 1 29,82 Z" />
        <path android:strokeColor="@color/ic_launcher_mark" android:strokeWidth="7"
            android:strokeLineCap="round" android:fillColor="@android:color/transparent"
            android:pathData="M37,36 V29 A13,13 0 0 1 63,29 V36" />
        <path android:strokeColor="@color/ic_launcher_check" android:strokeWidth="9"
            android:strokeLineCap="round" android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M38,60 L47,69 L64,50" />
    </group>
</vector>
